# Flask
FLASK_SECRET=replace-with-at-least-32-random-characters

# Shopify Dev Dashboard app (do not commit real values)
SHOPIFY_SHOP=71eaf7.myshopify.com
SHOPIFY_CLIENT_ID=replace-with-dev-dashboard-client-id
SHOPIFY_CLIENT_SECRET=replace-with-dev-dashboard-client-secret

# Shopify Admin GraphQL API and background synchronization
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SYNC_ENABLED=true
SHOPIFY_SYNC_INTERVAL_HOURS=1
SHOPIFY_SYNC_REQUEST_DELAY_SECONDS=0.15

# Optional: use the public storefront domain for product links.
# SHOPIFY_STOREFRONT_BASE_URL=https://your-store.example.com

# Legacy migration fallback only. Prefer client ID + secret above.
# SHOPIFY_ADMIN_ACCESS_TOKEN=
